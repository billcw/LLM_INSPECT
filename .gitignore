# ---- large regenerable artifacts ----------------------------------------
# jacobian_cache.pt is ~41 MB and is rebuilt by fit_jacobian.py.
# Git is bad at binary blobs and GitHub warns over 50 MB, so it stays out.
*.pt
*.pth
*.safetensors
*.bin
*.onnx

# ---- model / library caches ---------------------------------------------
.cache/
hf_cache/
huggingface/
models/

# ---- secrets: nothing with a token in it, ever --------------------------
.env
.env.*
*.token
secrets.*
token.txt

# ---- Windows / editor noise ---------------------------------------------
Thumbs.db
desktop.ini
*.lnk
.vscode/
.idea/
*.swp
*~

# ---- stray redirect artifacts -------------------------------------------
# A mistyped command can leave a zero-byte file named after a program.
uvicorn

